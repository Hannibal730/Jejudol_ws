<?xml version="1.0"?>
<package format="3">
  <name>vehicle_msgs</name>
  <version>0.1.0</version>
  <description>ROS2 interface package for vehicle-related messages.</description>

  <maintainer email="ekampourakis@ceid.upatras.gr">Emmanouil Kampourakis</maintainer>
  <maintainer email="boing0806@gmail.com">Jeong Boin</maintainer>
  <maintainer email="cds730@naver.com">Daeseung CHOI</maintainer>

  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>rosidl_default_generators</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>sensor_msgs</build_depend>

  <exec_depend>rosidl_default_runtime</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
