sudo apt update
sudo apt install -y python3-venv python3-dev build-essential

python3 -m venv .venv --system-site-packages
source .venv/bin/activate
export PYTHONNOUSERSITE=1

python -m pip install --upgrade pip setuptools wheel

python -m pip install torch==2.3.1 torchvision==0.18.1 torchaudio==2.3.1 --index-url https://download.pytorch.org/whl/cu118
python -c "import torch; print(torch.__version__, torch.__file__); print('CUDA Available:', torch.cuda.is_available())"

python -m pip install spconv-cu118

cd src/voxelnext_ros2
python -m pip install -r requirements.txt
python -m pip install catkin_pkg lark empy==3.3.4
python -m pip install "coverage>=7,<8"
python -m pip install -e . --no-build-isolation

